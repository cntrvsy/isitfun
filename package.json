{
	"name": "isitfun-monorepo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "concurrently -n \"api,web\" -c \"magenta,cyan\" \"npm run dev --workspace=@isitfun/api\" \"npm run dev --workspace=@isitfun/web\"",
		"dev:api": "npm run dev --workspace=@isitfun/api",
		"dev:web": "npm run dev --workspace=@isitfun/web",
		"build": "npm run build --workspaces --if-present",
		"build:api": "npm run build --workspace=@isitfun/api",
		"build:web": "npm run build --workspace=@isitfun/web",
		"check": "npm run check --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"db:generate": "npm run db:generate --workspace=@isitfun/db",
		"db:migrate": "npm run db:migrate --workspace=@isitfun/db",
		"db:sync": "npm run db:sync --workspace=@isitfun/db",
		"db:sync:remote": "npm run db:sync:remote --workspace=@isitfun/db",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"concurrently": "^9.1.2",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"typescript": "^6.0.0-beta"
	},
	"allowScripts": {
		"better-sqlite3@12.10.0": true,
		"better-sqlite3@12.6.2": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.0": true,
		"esbuild@0.27.3": true,
		"workerd@1.20260515.1": true
	}
}
