/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "isitfun",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-03-17",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"route": { "pattern": "isitfun.frstudios.co.ke", "custom_domain": true },
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"services": [
		{
			"binding": "API",
			"service": "isitfun-api"
		}
	],
	"kv_namespaces": [
		{
			"binding": "DRIFTER_CONTROL",
			"id": "9e69dd1ba52b453183fe69f07b719604"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["TelemetrySessionDO"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["TelemetrySessionDO"]
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
    "CREEM_TEST_MODE": "true",
    "RESEND_FROM_EMAIL": "IsItFun <noreply@frstudios.co.ke>",
    "TRUSTED_ORIGINS": "https://isitfun.frstudios.co.ke"
  }
}
