{
	"name": "@isitfun/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:e2e": "playwright test",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260815.1",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@isitfun/api": "*",
		"@libsql/client": "^0.17.2",
		"@opentelemetry/api": "^1.9.1",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-auto": "^8.0.0-next.3",
		"@sveltejs/adapter-cloudflare": "^8.0.0-next.6",
		"@sveltejs/kit": "^3.0.0-next.23",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^22.19.15",
		"@vitest/browser-playwright": "^4.0.18",
		"better-auth": "^1.6.23",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.56.9",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.0-beta",
		"typescript-eslint": "^8.54.0",
		"vite": "^8.2.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2",
		"wrangler": "^4.76.0"
	},
	"dependencies": {
		"@devmischief/shaders-svelte": "^0.0.9",
		"@isitfun/db": "*",
		"@isitfun/shared": "*",
		"@lucide/svelte": "^1.16.0",
		"@tanstack/svelte-table": "^9.1.2",
		"better-sqlite3": "^12.6.2",
		"d3-scale": "^4.0.2",
		"daisyui": "^5.5.19",
		"drizzle-valibot": "^0.4.2",
		"fflate": "^0.8.3",
		"hono": "^4.7.4",
		"layerchart": "^2.0.2",
		"resend": "^6.18.0",
		"svix": "^1.99.1",
		"valibot": "^1.4.0"
	},
	"allowScripts": {
		"better-sqlite3@12.10.0": true
	}
}
