# ==============================================================================
# ISITFUN — Environment Variables & Secrets Reference (v2 Monorepo)
# ==============================================================================
# Because apps/web communicates with apps/api via 0ms Cloudflare Service Bindings,
# ALL secrets live strictly in the Backend API Worker (apps/api).
#
# Local Development:
# - apps/api/.dev.vars -> Backend secrets & third-party API keys
# - apps/web/.env      -> Frontend local dev server URLs
#
# Production (Cloudflare Dashboard):
# - Worker `isitfun-api` -> Configure section #2 below in Settings -> Variables & Secrets
# - Worker `isitfun`     -> Zero secret env vars needed! (Configured via wrangler.jsonc)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (packages/db - Optional for local CLI)
# ------------------------------------------------------------------------------
# If omitted, drizzle.config.ts automatically resolves local Wrangler D1 SQLite
# DATABASE_URL=local.db

# ------------------------------------------------------------------------------
# 2. Backend Secrets (Place in apps/api/.dev.vars & `isitfun-api` Worker Secrets)
# ------------------------------------------------------------------------------
# REQUIRED in Production: 32+ character random secret (openssl rand -base64 32)
BETTER_AUTH_SECRET="generate-a-32-char-high-entropy-secret-key-here"
BETTER_AUTH_URL="http://localhost:8787"

# CORS & Trusted Origins (comma-separated)
TRUSTED_ORIGINS="http://localhost:5173,http://localhost:8787,https://isitfun.frstudios.co.ke"

# GitHub OAuth (Optional for social login)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (Optional for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend Email Integration (Optional for transactional emails & webhooks)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="IsItFun <noreply@frstudios.co.ke>"
RESEND_WEBHOOK_SECRET=""

# Creem Payments Integration (Optional for Project Pass & Team Plan checkout)
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
CREEM_PRODUCT_ID_PROJECT_PASS=""
CREEM_PRODUCT_ID_TEAM_PLAN=""
CREEM_TEST_MODE="true"

# ------------------------------------------------------------------------------
# 3. Frontend Local Dev Configuration (Place in apps/web/.env)
# ------------------------------------------------------------------------------
ORIGIN="http://localhost:5173"
API_BASE_URL="http://localhost:8787"
