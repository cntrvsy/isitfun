# ==============================================================================
# ISITFUN — Environment Variables & Secrets Reference (v2 Monorepo)
# ==============================================================================
# For local Cloudflare Worker development, place these in:
# - apps/api/.dev.vars (for apps/api secrets)
# - apps/web/.env (for apps/web client configs)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (packages/db)
# ------------------------------------------------------------------------------
# Optional: If omitted, drizzle.config.ts dynamically resolves local Wrangler D1 SQLite
DATABASE_URL=local.db

# ------------------------------------------------------------------------------
# 2. Backend Secrets (apps/api - Better-Auth, Payments & Email)
# ------------------------------------------------------------------------------
# 32+ character random secret (generate via: openssl rand -base64 32)
BETTER_AUTH_SECRET="generate-a-32-char-high-entropy-secret-key-here"
BETTER_AUTH_URL="http://localhost:8787"
SESSION_SECRET="generate-a-32-char-high-entropy-session-secret"

# GitHub OAuth (Optional for social login)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (Optional for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend Email Integration
RESEND_API_KEY=""
RESEND_FROM_EMAIL="IsItFun <noreply@frstudios.co.ke>"
RESEND_WEBHOOK_SECRET=""

# Creem Payments Integration
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
CREEM_PRODUCT_ID_PROJECT_PASS=""
CREEM_PRODUCT_ID_TEAM_PLAN=""
CREEM_TEST_MODE="true"

# CORS & Trusted Origins (comma-separated)
TRUSTED_ORIGINS="http://localhost:5173,http://localhost:8787,https://isitfun.frstudios.co.ke"

# ------------------------------------------------------------------------------
# 3. Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
ORIGIN="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"
